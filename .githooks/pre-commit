#!/usr/bin/env bash
#
# cgg pre-commit hook.
#
# Runs:
#   1. cargo test --workspace                  (fails -> abort commit)
#   2. cargo build --release -p cgg            (fails -> abort commit)
#   3. Install the fresh binary to PATH        (so other tools see it)
#   4. Regenerates README mermaid graphs       (fails -> abort commit)
#   5. Patches self-analysis stats             (fails -> abort commit)
#   6. Runs scripts/docs-check.py              (fails -> abort commit)
#   7. Stages README.md iff it changed
#
# Bypass with `git commit --no-verify` when you need to (e.g., pure
# docs commits that can't wait for a cold build).
#
# Install once per checkout:  scripts/install-hooks.sh

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Respect a user opt-out so CI / rebase flows aren't punished.
if [[ "${CGG_SKIP_PRECOMMIT:-}" == "1" ]]; then
    echo "[cgg pre-commit] CGG_SKIP_PRECOMMIT=1 set; skipping."
    exit 0
fi

# Tooling sanity.
for cmd in cargo python3 git; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "[cgg pre-commit] error: $cmd not found on PATH" >&2
        exit 1
    fi
done

echo "[cgg pre-commit] cargo test --workspace"
cargo test --workspace --quiet

echo "[cgg pre-commit] cargo build --release -p cgg"
cargo build --release -p cgg --quiet

# Publish the freshly-built binary to a PATH location so anything else
# on the system (agents, ad-hoc invocations, sibling repos like
# neurosymbolic_kb) picks up the same code we're about to commit.
# Honors CGG_INSTALL_DIR; defaults to ~/.local/bin which is on the
# user's PATH. Uses `install` so the new binary appears atomically.
CGG_INSTALL_DIR="${CGG_INSTALL_DIR:-$HOME/.local/bin}"
if [[ -n "$CGG_INSTALL_DIR" ]]; then
    if [[ ! -d "$CGG_INSTALL_DIR" ]]; then
        echo "[cgg pre-commit] creating $CGG_INSTALL_DIR"
        mkdir -p "$CGG_INSTALL_DIR"
    fi
    echo "[cgg pre-commit] installing to $CGG_INSTALL_DIR/cgg"
    install -m 755 target/release/cgg "$CGG_INSTALL_DIR/cgg"
fi

# Regenerate mermaid inputs into a scratch dir under target/ so we
# don't pollute /tmp across users/sandboxes.
MERMAID_DIR="target/cgg-readme-graphs"
mkdir -p "$MERMAID_DIR"

echo "[cgg pre-commit] regenerating cgg-walk graph"
./target/release/cgg ./crates/cgg-walk \
    -t mermaid \
    -o "$MERMAID_DIR/walk.mmd" \
    > /dev/null

echo "[cgg pre-commit] regenerating cgg-lang graph"
./target/release/cgg \
    ./crates/cgg-lang/src/detect.rs \
    ./crates/cgg-lang/src/parser.rs \
    ./crates/cgg-lang/src/lib.rs \
    -t mermaid \
    -o "$MERMAID_DIR/lang.mmd" \
    > /dev/null

echo "[cgg pre-commit] regenerating self-analysis graph"
./target/release/cgg ./crates --filter 'cgg::run$' -n 1 \
    -o "$MERMAID_DIR/self.mmd" 2>"$MERMAID_DIR/self.stderr" >/dev/null

echo "[cgg pre-commit] patching README.md mermaid blocks"
python3 scripts/update-readme-graphs.py --self-test
# `raw:self` is verbatim on purpose — the README presents that block as
# the output of the command printed directly above it, so cleaning it
# would make the two disagree. It lived outside the markers until 0.4.1
# and had drifted: same topology, stale node ids.
python3 scripts/update-readme-graphs.py \
    walk "$MERMAID_DIR/walk.mmd" \
    lang "$MERMAID_DIR/lang.mmd" \
    raw:self "$MERMAID_DIR/self.mmd"

echo "[cgg pre-commit] patching README.md self-analysis stats"
python3 scripts/update-readme-stats.py < "$MERMAID_DIR/self.stderr"

echo "[cgg pre-commit] checking docs consistency"
python3 scripts/docs-check.py

# Stage README if it was modified (either from this hook or a manual
# edit the user already had pending).
if ! git diff --quiet --exit-code README.md; then
    echo "[cgg pre-commit] README.md updated; staging."
    git add README.md
else
    echo "[cgg pre-commit] README.md unchanged."
fi

echo "[cgg pre-commit] ok"
