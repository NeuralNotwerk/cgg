      "signature_hint": "cache_profile_image <- function(profile_image_url, location = \"www\", default = \"twitter-default-profile.jpg\") { file_serve <- str_replace(profile_image_url, \".+/profile\", \"profile\") file_local <- fs::path(location, file_serve) if (fs::file_exists(file_local)) { x <- list(result = file_serve) } else { fs::dir_create(fs::path_dir(file_local)) x <- safely(download.file)(profile_image_url, file_local) # On fist download, the image won't be ready for the UI, so show default if (is.null(x$error)) x$result <- default } if (is.null(x$error)) x$result else default }"
