+    fn zig_type(
+        &self,
+        file: FileId,
+        segs: &[String],
+        site: Option<u32>,
+        depth: u8,
+    ) -> Option<ZigTy> {
+        if depth > MAX_DEPTH {
+            return None;
+        }
+        let (head, rest) = segs.split_first()?;
+        if let Some(bind) = self.zig_binds.get(&file).and_then(|b| b.get(head)) {
+            let (g, path) = match bind {
+                ZigBind::Alias(path) => {
+                    let mut expanded: Vec<String> =
