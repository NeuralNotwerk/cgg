+/// Trait>::f`) rather than a module (`krate::module::f`).
+fn rust_type_owned(qn: &str) -> bool {
+    let Some((prefix, _)) = crate::names::split_last_segment(qn) else {
+        return false;
+    };
+    prefix.ends_with('>')
