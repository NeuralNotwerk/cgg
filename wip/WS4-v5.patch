+/// and the calling file's import tables.
+#[derive(Clone, Copy)]
+struct BareScope<'s> {
+    r: &'s cgg_core::RefRecord,
+    caller: Option<CallableId>,
+    caller_file: FileId,
+    caller_qn: Option<&'s str>,
+    module_aliases: &'s HashMap<String, String>,
