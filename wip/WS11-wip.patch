+/// the container's own method, never `T`'s.
+pub const MAYBE_TYPE_WRAPPERS: &[(&str, &[&str])] = &[
+    (
+        "python",
+        &[
+            "Optional",
+            "ClassVar",
+            "Final",
+            "Annotated",
+            "InitVar",
+            "Required",
+            "NotRequired",
