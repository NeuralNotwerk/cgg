+/// The member-naming attributes of one built-in rule.
+pub fn member_sources_for(id: &str, language: &str) -> &'static [MemberSource] {
+    match (id, language) {
+        ("junit-sources", "java") => &[
+            MemberSource {
+                attribute: "MethodSource",
+                default_self: true,
+                type_members: NONE,
+            },
+            MemberSource {
+                attribute: "ArgumentsSource",
+                default_self: false,
+                type_members: &["provideArguments"],
+            },
+        ],
+        ("nunit-runner", "csharp") => &[
+            MemberSource {
+                attribute: "TestCaseSource",
+                default_self: false,
+                type_members: &["GetEnumerator"],
+            },
+            MemberSource {
+                attribute: "ValueSource",
+                default_self: false,
+                type_members: &["GetEnumerator"],
+            },
+        ],
+        ("xunit-data", "csharp") => &[
+            MemberSource {
+                attribute: "MemberData",
+                default_self: false,
+                type_members: NONE,
+            },
+            MemberSource {
+                attribute: "ClassData",
+                default_self: false,
+                type_members: &["GetEnumerator"],
+            },
