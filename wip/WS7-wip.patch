+                        target_name: t.qualified_name.clone(),
+                        evidence: format!(
+                            "named by `{}` on `{}`",
+                            attr.trim(),
+                            node.qualified_name
+                        ),
+                        file: node.file,
+                        site_line: node.start_line,
+                        node: rule.node,
