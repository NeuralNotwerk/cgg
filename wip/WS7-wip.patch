+/// method takes none.
+#[derive(Debug)]
+pub struct SignatureMethod {
+    pub name: &'static str,
+    pub params: &'static [&'static str],
+}
+
+/// The signature-keyed hooks of one built-in rule.
+pub fn signature_methods_for(id: &str, language: &str) -> &'static [SignatureMethod] {
+    match (id, language) {
+        ("java-serialization", "java") => &[
+            SignatureMethod {
+                name: "readObject",
+                params: &["ObjectInputStream"],
+            },
+            SignatureMethod {
+                name: "writeObject",
+                params: &["ObjectOutputStream"],
+            },
+            SignatureMethod {
+                name: "readObjectNoData",
+                params: NONE,
+            },
+            SignatureMethod {
+                name: "readResolve",
+                params: NONE,
+            },
+            SignatureMethod {
+                name: "writeReplace",
+                params: NONE,
+            },
