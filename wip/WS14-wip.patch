+const ZIG_SPEC: Spec = Spec {
+    idents: &["identifier"],
+    binders: &[
+        b("parameter", &["name"], Scope::Param),
+        b1("variable_declaration", Scope::Decl),
+        b("payload", &[""], Scope::Decl),
