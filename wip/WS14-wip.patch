+                        );
+                        // Parameters and locals, from the same tree: a
+                        // bare call through one is never another file's
+                        // function (see `cgg_lang::locals`).
+                        if f.locals.is_empty() {
+                            f.locals =
+                                cgg_lang::locals::collect(&f.language, &out.tree, &bytes);
+                        }
+                        f
