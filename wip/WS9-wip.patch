+    let lt = open.child_by_field_name("op")?;
+    let gt = close.child_by_field_name("op")?;
+    if !matches!(ty.kind(), "simple_identifier" | "navigation_expression")
+        || ty.end_byte() != lt.start_byte()
+        || gt.end_byte() != prefix.start_byte()
+    {
