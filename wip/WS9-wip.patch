+    /// identifier), so a name that legitimately contains no type
+    /// arguments is returned as written.
+    fn callee_name(&self, n: Node) -> String {
+        match n.kind() {
+            "generic_name" => n
+                .children(&mut n.walk())
+                .find(|c| c.kind() == "identifier")
+                .map(|c| self.text(c).to_string())
+                .unwrap_or_default(),
+            _ => self.text(n).to_string(),
+        }
+    }
